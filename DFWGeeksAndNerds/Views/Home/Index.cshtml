@{
    ViewData["Title"] = "Home Page";
}

<!-- Carousel -->

<div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3" aria-label="Slide 4"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="4" aria-label="Slide 5"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="5" aria-label="Slide 6"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="6" aria-label="Slide 7"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="7" aria-label="Slide 8"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="8" aria-label="Slide 9"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="9" aria-label="Slide 10"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="~/images/dfwgeeksandnerdsResized.png" alt="FirstSlide">
            </div>
            <div class="carousel-item">
                <img class="d-block w-100" src="~/images/AlamoDraftHouseResized.png" alt="SecondSlide">
                </div>
                <div class="carousel-item">
                    <img class="d-block w-100" src="~/images/akonResized.png" alt="ThirdSlide">
                    </div>

                    <div class="carousel-item">
                        <img class="d-block w-100" src="~/images/GGEZGamer.png" alt="FourthSlide">
                        </div>

                        <div class="carousel-item">
                            <img class="d-block w-100" src="~/images/CommonGroundGamesResized.png" alt="FifthSlide">
                        </div>

                        <div class="carousel-item">
                            <img class="d-block w-100" src="~/images/cosplayResized.jpg" alt="SixthSlide">
                        </div>

                        <div class="carousel-item">
                            <img class="d-block w-100" src="~/images/D&DResized.jpg" alt="SeventhSlide">
                        </div>

                        <div class="carousel-item">
                            <img class="d-block w-100" src="~/images/RedDoorEscapeRoomResized.jpg" alt="EscapeRooms">
                            </div>

                            <div class="carousel-item">
                                <img class="d-block w-100" src="~/images/freeplayResized.jpg" alt="Arcade">
                            </div>

                            <div class="carousel-item">
                                <img class="d-block w-100" src="/images/mainEventResized.jpg" alt="MainEvent">
                            </div>
         
                        </div>
                        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </a>
                        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </a>
                    </div>


<!-- Hero Section  -->
<!-- 
px-4 adds padding on the x-axis
py-5 adds padding on the y-axis 
my-5 adds margin on the y-axis to separate it from the nav and footer
text-center centers all the text inside this div

-->
<div class="row col-12 justify-content-center bg-warning">
    <div class="col-6 bg-primary">
                            <div class="px-4 py-5 my-5 text-center">
                                <!--
    •	d-block mx-auto: Sets the display to block and auto-calculates left/right margins to perfectly center the image horizontally.
    •	mb-4: Adds margin to the bottom to push the text down.
    •	img-fluid: Makes the image responsive so it scales nicely on smaller screens.
    •	src="~/": The ~ is an ASP.NET Core feature that safely resolves the path starting from your wwwroot folder.
    •	style="...": Inline CSS to cap the height at 300px, round the corners (border-radius), and add a soft drop shadow (box-shadow).
    -->
                                <img class="d-block mx-auto mb-4 img-fluid" src="~/images/dfwgeeksandnerds.jpg" alt="NintendoCharactersPlayingPoker" style="max-height: 300px; border-radius: 15px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                    <!--
    display-5: A Bootstrap typography class that makes the heading larger and more prominent than a standard <h1>.
    fw-bold: Specifically ensures the font weight is bold.
    body-emphasis: Uses the theme's high-contrast color text.
    -->
                                    <h1 class="display-5 fw-bold text-body-emphasis">DFW Geeks and Nerds</h1>
                                    <!--
    Wraps the paragraph and buttons to constrain their width on large screens.
    col-lg-6: On large screens (desktops), this restricts the width to 6 columns (50% of the screen).
    mx-auto: Centers this 50%-width column in the middle of the screen.
    -->

                                    <div class="col-lg-6 mx-auto">
                                        <!--
        lead: Increases the font size and line height slightly, great for introductory text.
        mb-4: Adds margin below the paragraph to push the buttons down.
        -->
                                        <p class="lead mb-4">Come play games with your fellow nerds in the DFW area! Join us for tabletop board games, video game tournaments, lively discussions, and local meetups.</p>

                                        <!--
        Controls button alignment based on screen size.
        d-grid gap-2: On small mobile devices, forces the buttons to stack vertically with a small gap.
        d-sm-flex justify-content-sm-center: On small (sm) screens and larger, changes to a flexbox layout so buttons sit side-by-side and are centered.
        -->
                                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                                            <!--
            asp-controller & asp-action: ASP.NET Core Tag Helpers that automatically generate the correct URL route mapping to the EventsController's Events action.
            btn btn-primary btn-lg px-4: Styles the anchor tag to look like a large primary button with standard horizontal padding.
            -->
                                            <a asp-controller="Events" asp-action="Events" class="btn btn-primary btn-lg px-4 gap-3">View Upcoming Events</a>

                                            <!--
            btn-outline-secondary: Gives the button a transparent background with a bordered outline until it is hovered over.
            -->
                                            <a href="#" class="btn btn-outline-secondary btn-lg px-4">Join Our Community</a>
                                        </div>
                                    </div>
                                </div>

    </div>

    <div class="col-6 bg-success">
                                <div class="px-4 py-5 my-5 text-center">
