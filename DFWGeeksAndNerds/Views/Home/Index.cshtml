@{
    ViewData["Title"] = "Home Page";
}



@* <img src="~/images/dfwgeeksandnerds.jpg" alt="NintendoCharactersPlayingPoker">
<figcaption>Come play games with your fellow nerds in the DFW area!</figcaption> *@

<!-- Carousel -->

<div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
    <ol class="carousel-indicators">
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="4"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="5"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="6"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="7"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="8"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="9"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="10"></li>

      
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="~/images/dfwgeeksandnerdsResized.png" alt="FirstSlide">
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="~/images/AlamoDraftHouseResized.jpg" alt="SecondSlide">
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="~/images/akonResized.png" alt="ThirdSlide">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="~/images/GGEZGamer.png" alt="FourthSlide">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="/images/CommonGroundGamesResized.jpg" alt="FifthSlide">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="/images/cosplayResized.jpg" alt="SixthSlide">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="/images/D&DResized.jpg" alt="SeventhSlide">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="~/images/RedDoorEscapeRoom.png" alt="EscapeRooms">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="/images/freeplayResized.jpg" alt="Arcade">
        </div>

        <div class="carousel-item">
            <img class="d-block w-100" src="/images/mainEventResized.jpg" alt="MainEvent">
        </div>
         
    </div>
    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </a>

</div>


