@{
    ViewData["Title"] = "VideoGames Page";
}

<!-- Note: Update the images on the cards - thought was logos for the various 
video game consoles, but if we want to generate an image for honorable mentions or 
change the name we can do that
-->

<div class="text-center">
    <h1 class="display-4">Video Games</h1>
    <p>Welcome to the Video Games page!</p>
</div>

<div class="container mt-4">
    <div class="row g-4">
        <!-- href="#" is an empty link, but will be populated later to go to the specific console page -->
        <!-- Card 1 -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <img src="~/images/nintendo.jpg"
                     class="card-img-top"
                     alt="Nintendo">

                <div class="card-body">
                    <h5 class="card-title">Nintendo</h5>

                    <p class="card-text">
                        Need to Know Nintendo
                    </p>

                    <a href="/VideoGames/Nintendo" class="btn btn-danger">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <img src="~/images/Xbox.jpg"
                     class="card-img-top"
                     alt="Xbox">

                <div class="card-body">
                    <h5 class="card-title">Xbox</h5>

                    <p class="card-text">
                        Need to Know Xbox
                    </p>

                    <a href="/VideoGames/Xbox" class="btn btn-success">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <img src="~/images/PlayStation.jpg"
                     class="card-img-top"
                     alt="PlayStation">

                <div class="card-body">
                    <h5 class="card-title">PlayStation</h5>

                    <p class="card-text">
                        Need to Know PlayStation
                    </p>

                    <a href="/VideoGames/PlayStation" class="btn btn-dark">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <img src="~/images/steam.jpg"
                     class="card-img-top"
                     alt="STEAM">

                <div class="card-body">
                    <h5 class="card-title">STEAM</h5>

                    <p class="card-text">
                        Need to Know STEAM
                    </p>

                    <a href="/VideoGames/STEAM" class="btn btn-primary">
                        Open
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>