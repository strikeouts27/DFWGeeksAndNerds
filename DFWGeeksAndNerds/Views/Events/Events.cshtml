@using DFWGeeksAndNerds.Models;
@model List<EventViewModel>;

@{
    ViewData["Title"] = "Events Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/EventCalendar.css" asp-append-version="true" />
}
<a href="c:\users\strib\source\repos\dfwgeeksandnerds\dfwgeeksandnerds\views\events\calander.cshtml">c:\users\strib\source\repos\dfwgeeksandnerds\dfwgeeksandnerds\views\events\calander.cshtml</a>
<div>
    <div class="container"> 
        @{
            int daysinmonth = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);
            int currentDay = 1; 
        }
        @daysinmonth
        @for(int y = 1; y<6; y++){
        <div class="row">
            @for(int x=1; x < 8; x++)
            {
                    @if (currentDay > daysinmonth)
                    {
                        <div class="col-1 border border-dark calander-box calander-box-disabled"></div>
                    } else
                    {
                        <div class="col-1 border border-dark calander-box">@currentDay</div>
                        currentDay++;
                    }
               
                    
                }
            </div>
            
              
        }

    </div>
</div>

