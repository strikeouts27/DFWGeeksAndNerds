<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DFWGeeksAndNerds</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DFWGeeksAndNerds.styles.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/cee17c54f7.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div class="container-fluid">
        <navbar class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
      
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DFWGeeksAndNerds</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Anime" asp-action="Anime">Anime</a>
                        </li>
                        <!--
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Boardgames" asp-action="Boardgames">Boardgames</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Collectables" asp-action="Collectables">Collectables</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Cosplay" asp-action="Cosplay">Cosplay</a>
                        </li>
                        --> 
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Events" asp-action="Events">Events</a>
                        </li>
                        <li>
                            <a class="nav-link text-white" asp-area="" asp-controller="Games" asp-action="Games">Games</a>
                        </li>

                        <!--
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Podcasts" asp-action="Podcasts">Podcasts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Music" asp-action="Music">Music</a>
                        </li>
                        -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="News" asp-action="News">News</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Venues" asp-action="Venues">Venues</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="VideoGames" asp-action="Videogames">Video Games</a>
                        </li>

                    </ul>
                </div>
            </div>
        </navbar>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
<footer class="bg-dark text-white py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h5>DFW Geeks & Nerds</h5>
                <p>Building a community for anime, gaming, and geek culture in Dallas-Fort Worth.</p>
            </div>
            <div class="col-md-4 text-center">
                <h5>Quick Links</h5>
                <ul class="list-unstyled">
                    <li><a href="#" class="text-white">About Us</a></li>
                    <li><a href="#" class="text-white">Club Rules</a></li>
                    <li><a href="#" class="text-white">Ask A Question</a></li>
                    <li><a href="#" class="text-white">Suggest an Event</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5>Connect</h5>
                <p>Email: contact@dfwgeeksandnerds.com</p>
                <p>Follow us on social media!</p>
                <!-- Add social media icons here -->
                <i class="fa-brands fa-facebook"></i>
                <i class="fa-brands fa-x-twitter"></i>
                <i class="fa-brands fa-instagram"></i>
            </div>
        </div>
        <hr class="bg-white">
        <div class="text-center">
            <p>&copy; 2026 DFWGeeksAndNerds. All rights reserved.</p>
        </div>
    </div>
</footer>
</html>
