@using DFWGeeksAndNerds.Shared.DTOs
@using DFWGeeksAndNerds.Web.ViewModels;
@using DFWGeeksAndNerds.Shared.Services; 
<!--Inject services with atinject service servicename -->
@* @inject IHttpClientFactory ClientFactory;  *@
@inject EventsDataService EventsDataService; 

<style>
    .carousel-inner .carousel-item img {
        height: 600px;
        width: 100%;
        object-fit: cover;
    }

    .calendar-box {
        width: 175px;
        height: 175px;
        font-size: 10px;
    }

    .calendar-box-disabled {
        background-color: darkgray;
    }

    .calendar-header {
        width: 175px;
        height: 30px;
        margin-top: 20px;
    }

    .calendar-event {
        font-size: 10px;
    }

</style>

<div>
    <div class="container">
        @* @{
            <!-- TODO CREATE MONTHS-->
            string monthName = DateTime.Now.ToString("MMMM");
            <!-- To get all of the months in a list -->
            List<string> monthNames = new List<string>();
            <!-- Loop through the months and add them to the list -->
            for (int i = 1; i <= 12; i++)
            {
                monthNames.Add(new DateTime(DateTime.Now.Year, i, 1).ToString("MMMM"));
            }
        } *@

        @{
            DateTime dtSelectedDate = new DateTime(2026, 5, 1) ;


            // Get the number of days in the current month
            <!--I need the current month to be displayed on the page -->
            string currentMonth = dtSelectedDate.ToString("MMMM");
            string currentYear = dtSelectedDate.ToString("yyyy");
            int daysInMonth = DateTime.DaysInMonth(dtSelectedDate.Year, dtSelectedDate.Month);
            // ceiling will always round up an integer upwards by one whole number integer. 
            // This value is based on july 2026 4.42 -> 5 days a week 
            int weeksInMonth = (int)Math.Ceiling(daysInMonth / 7.0);
            int currentDay = 1;

            
        }

        <!--Display the month name -->
        
        <div class="row">
            <h1 class="col-4">@currentMonth @currentYear</h1>
            <!--
           <form model="@Model" method="post">
                <input type="hidden" name="modelJson" value="@JsonConvert.SerializeObject(Model)" />
                <button type="submit" formaction="@Url.Action("PrevMonth", "Events")" class="col-2 btn btn-secondary mx-3">prev</button>
                <button type="submit" formaction="@Url.Action("NextMonth", "Events")" class="col-2 btn btn-primary mx-3">next</button>
            </form>
            --> 
        </div>
       
        <!-- I need a row to show the days of the week -->


    
        <div class="row">
            @for (int count = 0; count <= (int)DayOfWeek.Saturday; count++)
            {
                // int i = (startIndex + count) % daysOfWeek.Count;
                <div class=" daysOfWeekRow calendar-header col-1 text-center fw-bold">
                    @Enum.GetNames(typeof(DayOfWeek))[count]
                </div>
            }
        </div>

        @{
            // 01:25:59
            <!-- We need a start date for the calendar -->
            // this is the number of blocks that need to be disabled before the first day of the month.  -->
            // starting from a 0 based index enum with sunday being 0
            // 0 based index 
            int startBlock = (int)dtSelectedDate.DayOfWeek;

            // spot the error in the process
            // back up and simply the process 

            // enum daysInWeek = {"Monday", };

            // this is the number of blocks that need to be disabled after the last day of the month.  -->
            int endBlock = DateTime.DaysInMonth(dtSelectedDate.Year, dtSelectedDate.Month) - 1;
            // block count is for every box in the calander. 
            int blockCount = 0;
            // what pieces of data am i working with and what rulesets do they have. example 0 based indexes
            // what can i do to fix alignment issues? i can use additon and subtraction. 
            // if the evaluation part of the method or code is off, than i need to look at the filters/operators on that evaluation method. <> <=
        }
        <!-- 5 rows needed for the 4 weeks and extra days -->
        @for (int y = 0; y <= weeksInMonth; y++)
        {
            <div class="row">
                <!-- 7 columns for the 7 days of the week -->
                @for (int x = 1; x < 8; x++)
                {

                    @if (blockCount < startBlock)
                    {
                        // this is the number of blocks that need to be disabled before the first day of the month.  -->
                        <div class="col-1 border border-dark calendar-box calendar-box-disabled"></div>

                    }
                    else if (blockCount > endBlock + startBlock)
                    {
                        // If the block count is greater than the number of days in the month we don't want to make those days accessible.
                        <div class="col-1 border border-dark calendar-box calendar-box-disabled"></div>
                    }
                    else
                    {
                        // this is a filter where we are looking at the events and seeing if there are any events that match the current day and month. If there are we want to display the event name in the calendar box.
                        //var eventsForDay = await GetEvents(); //Model.CurrentEvents(currentDay);
                        // if the events for the day is not empty in its explanation and there is at least one event....
                        if (eventsForDay != null && eventsForDay.Count() > 0)
                        {
                            // show that event in the calendar box.
                            <div class="col-1 border border-dark calendar-box">
                                <div>
                                    @currentDay
                                </div>
                                          
                                @foreach (var eventItem in eventsForDay)
                                {

                                    if (
                                        eventItem.EventDate.Year == dtSelectedDate.Year &&
                                        eventItem.EventDate.Month == dtSelectedDate.Month &&
                                        eventItem.EventDate.Day == currentDay
                                        )
                                    {
                                        <div class="calendar-event-indicator">@eventItem.EventName</div>
                                    }

                                }
                            </div> <!-- Close the calendar box here -->
                        }
                        // If there are no events...
                        else
                        {
                            <div class="col-1 border border-dark calendar-box">
                                <div>@currentDay</div>
                            </div>
                        }
                        currentDay++;
                    }
                    blockCount++;
                }
            </div>
        }

    </div>
</div>

@code{
    HttpClient client;
    List<EventNameDTO> eventsForDay = new List<EventNameDTO>();

    // utlize this code once for inital launching of the webpage and reloads. button click actions, will not trigger this code to run. 
    protected override async Task OnInitializedAsync()
    {

        //client = ClientFactory.CreateClient("DFWGeeksAndNerdsAPI");

        eventsForDay = await GetEvents();

        await base.OnInitializedAsync();
    }

    private async Task<List<EventNameDTO>> GetEvents()
    {
        // return await client.GetFromJsonAsync<EventDTO>("/events");
        // long running code and tasks 
        var events = await EventsDataService.GetEventsNamesAsync();
        return events;

    }
}

