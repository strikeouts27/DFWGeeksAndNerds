@page "/videogames"
<PageTitle>Video Games</PageTitle>

<div class="container mb-4">
    <h1 class="display-4">Video Games</h1>
    <p class="lead">Check out some of our favorite games to play together!</p>
</div>

<!-- Using Bootstrap row-cols-md-5 ensures exactly 5 cards per row on medium/large screens -->
<div class="row row-cols-1 row-cols-md-5 g-4 mb-5">
    @foreach (var game in Games)
    {
        <div class="col">
            <div class="card h-100">
                <!-- Using a placeholder image generator if image is empty/missing, else using specific image -->
                <img src="@game.ImagePath" class="card-img-top p-2" alt="@game.Title" style="height: 15rem; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">@game.Title</h5>
                    <p class="card-text">@game.Description</p>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-center pb-3">
                    <a href="#" class="btn btn-primary">Let's Play</a>
                </div>
            </div>
        </div>
    }
</div>

