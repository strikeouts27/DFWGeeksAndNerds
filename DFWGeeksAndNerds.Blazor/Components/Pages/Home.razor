@using BlazorBootstrap

@page "/"

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<!-- moved styles to component-scoped Home.razor.css to avoid inline styles -->
<style>

	.carousel-image {
		width: 100% !important;
		height: 750px !important;
		object-fit: cover !important;
	}

	.home-carousel-container ::deep .carousel-item img {
		height: 1000px;
		width: 100%;
		object-fit: cover;
	}

</style>

<div class="home-WhoWeAre-carousel-container">
	<Carousel ShowIndicators="true" Autoplay="CarouselAutoPlay.StartOnPageLoad" Interval="3000" Class="px-2">
		<CarouselItem Active="true">
			<Image Src="/images/Venues/BishopCidercade_596.jpg" class="carousel-image"/>
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/freeplay.jpg" class="carousel-image"/>
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/MadnessGamesAndComics.jpg" class="carousel-image" />
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/DallasMuseumOfArt.jpg" class="carousel-image"></Image>
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/Pinstack.jpg" class="carousel-image"></Image>
		</CarouselItem>
	</Carousel>
</div>

<div class="row">

<div class="container-fluid mt-4">
	<div class="row">
	<!-- COLUMN 1: The Carousel (Spans 8 out of 12 columns on medium+ screens) -->
		<div class="col-md-8">
			<div class="home-carousel-container">

				<Carousel ShowIndicators="true" Autoplay="CarouselAutoPlay.StartOnPageLoad" Interval="3000" Class="px-2">
					<CarouselItem Active="true">
						<Image Src="/images/Home/teamRocket.jpg" class="carousel-image" />
					</CarouselItem>
					<CarouselItem>
						<Image Src="/images/Home/nationalVideoGamesMuseum.jpg" class="carousel-image" />
					</CarouselItem>
					<CarouselItem>
						<Image Src="/images/Home/pokemonGo.jpg" class="carousel-image" />
					</CarouselItem>
					<CarouselItem>
						<Image Src="/images/Home/escapeRooms.jpg" Class="carousel-image"/>
					</CarouselItem>
				</Carousel>
			</div>
		</div>
		<div class="col-md-4">
			<div class="WhoWeAre">
				<p>
					The DFW Geeks and Nerds was founded to help local nerds and geeks congregate to do nerd activites and explore Dallas.
					This group has events that are designed for 18+ and and some events for familes. We want you to come to these events and share with us the nerdy things that you are passionate about.
				</p>
			</div>
		</div>
	</div>
</div>

</div>



<div class="container-fluid">
	<div class="row">

			<div class="col-md-8">
