@using BlazorBootstrap

@page "/"

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<!-- moved styles to component-scoped Home.razor.css to avoid inline styles -->
<style>

	.carousel-image {
		width: 100% !important;
		height: 750px !important;
		object-fit: cover !important;
	}

	.home-carousel-container ::deep .carousel-item img {
		height: 1000px;
		width: 100%;
		object-fit: cover;
	}

</style>

<p>Welcome to the DFW Geeks and Nerds Website! Come Explore Dallas Fort Worth and Hang Out With Your Fellow Nerds!</p>

<div class="home-WhoWeAre-carousel-container">
	<Carousel ShowIndicators="true" Autoplay="CarouselAutoPlay.StartOnPageLoad" Interval="3000" Class="px-2">
		<CarouselItem Active="true">
			<Image Src="/images/Home/DallasFortWorthSkyline.jpg" class="carousel-image" />
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/MadnessGamesAndComics.jpg" class="carousel-image" />
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Home/NationalVideoGameMuseum.jpg" class="carousel-image" />
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Home/Nerdvana.jpg" Class="carousel-image" />
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/freeplay.jpg" class="carousel-image" />
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/DallasMuseumOfArt.jpg" class="carousel-image"></Image>
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/Pinstack.jpg" class="carousel-image"></Image>
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Venues/BishopCidercade.jpg" class="carousel-image"></Image>
		</CarouselItem>
		<CarouselItem>
			<Image Src="/images/Home/DFWGeeksAndNerds.jpg" class="carousel-image"></Image>
		</CarouselItem>
	</Carousel>
</div>

<div class="row">
<div class="container-fluid mt-4">
	
	<div class="row">
	<!-- COLUMN 1: The Carousel (Spans 8 out of 12 columns on medium+ screens) -->
		<div class="col-md-8">
			<div class="home-carousel-container">

				<Carousel ShowIndicators="true" Autoplay="CarouselAutoPlay.StartOnPageLoad" Interval="3000" Class="px-2">
					<CarouselItem Active="true">
						<Image Src="/images/Home/teamRocket.jpg" class="carousel-image" />
					</CarouselItem>
					<CarouselItem>
						<Image Src="/images/Home/DandD.jpg" class="carousel-image" />
					</CarouselItem>
					<CarouselItem>
						<Image Src="/images/Home/pokemonGo.jpg" class="carousel-image" />
					</CarouselItem>
					<CarouselItem>
						<Image Src="/images/Home/escapeRooms.jpg" Class="carousel-image"/>
					</CarouselItem>
				</Carousel>
			</div>
		</div>

		<div class="col-md-4">
				<Accordion>

					<AccordionItem Title="What is DFW Geeks and Nerds?" IsActive="true">
						<Content>
							We are a community in Dallas-Fort Worth that congregates to do nerdy activities, explore the city,
							and share the geeky things we are passionate about!
						</Content>
					</AccordionItem>

					<AccordionItem Title="What events do your club run?">
						<Content>
							<li>Anime Conventions</li>
							<li>Video Game Lan Parties</li>
							<li>Anime Nights</li>		
							<li>Virtual Reality Game Nights</li>
							<li>Musuems of Dallas</li>
							<li>Movie Night</li>
							<li>Dinner Nights with Trivia</li>
							<li>Board Game Nights</li>
							<li>Arcade Nights</li>
							<li>Card Game Tournaments</li>
							<li>Nature Walks and Camping</li>
							<li>Pokemon Go</li>
							<li>Escape Rooms</li>
							<li>Medevil times</li>
							<li>Laser Tag and Bowling</li>
							<li>Esports Events</li>
						</Content>
					</AccordionItem>

					<AccordionItem Title="Are these events family-friendly?">
						<Content>
							Some of our events are designed for families, but please note that many of our events are strictly 18+.
							Check the event details before signing up!
						</Content>
					</AccordionItem>

					<AccordionItem Title="Can I suggest an event?">
						<Content>
							We love event suggestions! You can use the event suggestion form right here on our website.
						</Content>
					</AccordionItem>

					<AccordionItem Title="How can I join the group?">
						<Content>
							We do have a membership form that helps us discover a bit more about who you are and what you want in a nerd club. We want to understand what is trending in the DFW area?
						</Content>
					</AccordionItem>
				
					<AccordionItem Title="Does it cost money to join?">
						<Content>
							No it does not. Each event is different. Some are free events. Others have costs that come with them. We try to be as transparent as possible. 
						</Content>
					</AccordionItem>

					<AccordionItem Title="How can I learn more about the club?">
						<Content>
							You can contact us at dfwgeeksandnerds@gmail.com. 
						</Content>
					</AccordionItem>

				</Accordion>

		</div>

		</div>
	</div>
</div>

<div class="container mt-4">
	<h3>Join DFW Geeks and Nerds!</h3>

	<!-- EditForm binds to our C# model -->
	<EditForm Model="@newMember" OnValidSubmit="RegisterMember">

		<!-- Standard Bootstrap 5 Form Layout -->
		<div class="mb-3">
			<label for="name" class="form-label">Your Name</label>
			<!-- InputText is Blazor's version of <input type="text"> -->
			<InputText id="name" class="form-control" @bind-Value="newMember.Name" />
		</div>

		<div class="mb-3">
			<label for="email" class="form-label">Email Address</label>
			<InputText id="email" type="email" class="form-control" @bind-Value="newMember.Email" />
		</div>

		<div class="mb-3">
			<label for="interest" class="form-label">What events would you like to see in the club?</label>
			<InputText id="interest" class="form-control" @bind-Value="newMember.FavoriteInterest" placeholder="e.g. Board Games, Anime..." />
		</div>

		<button type="submit" class="btn btn-primary">Sign Up!</button>
	</EditForm>
</div>

@code {
	// 1. Create an instance of the model to hold the form data
	private ClubMember newMember = new ClubMember();

	// 2. Define what happens when the form is submitted
	private void RegisterMember()
	{
		// This is where you would normally save 'newMember' to a database!
		Console.WriteLine($"New member {newMember.Name} registered!");
	}

	// 3. Create a C# Class (Model) to represent the form data
	public class ClubMember
	{
		public string Name { get; set; } = "";
		public string Email { get; set; } = "";
		public string FavoriteInterest { get; set; } = "";
	}
}