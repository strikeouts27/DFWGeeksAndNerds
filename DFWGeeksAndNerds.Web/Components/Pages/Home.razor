@using BlazorBootstrap

@page "/"

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<style>
	.carousel-image {
		width:100% !important;
		height:500px !important; 
		object-fit: cover !important; 
	}
</style>

<Carousel ShowIndicators="true" Autoplay="CarouselAutoPlay.StartOnPageLoad" Interval="3000" Class="px-2">
	<CarouselItem Active="true">
		<Image Src="/images/escapeRooms.jpg" class="carousel-image"/>
	</CarouselItem>
	<CarouselItem>
		<Image Src="/images/freeplay.jpg" class="carousel-image" />
	</CarouselItem>
	<CarouselItem>
		<Image Src="/images/MadnessGamesAndComics.jpg" class="carousel-image" />
	</CarouselItem>
</Carousel>

